<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- ========================================================= -->
    <!-- 1️⃣ TẠO BẢNG SHIPMENTS                                     -->
    <!-- ========================================================= -->
    <changeSet id="001-init-shipment" author="microshop">
        <createTable tableName="shipments">
            <column name="shipment_id" type="varchar(40)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="shipper_id" type="varchar(40)"/>
            <column name="status" type="varchar(30)">
                <constraints nullable="false"/>
            </column>

            <column name="buyer_name" type="varchar(255)"/>
            <column name="buyer_phone" type="varchar(20)"/>

            <column name="address_line" type="varchar(500)"/>
            <column name="ward" type="varchar(255)"/>
            <column name="district" type="varchar(255)"/>
            <column name="city" type="varchar(255)"/>
            <column name="country" type="varchar(255)"/>
            <column name="lat" type="numeric(10,6)"/>
            <column name="lon" type="numeric(10,6)"/>

            <column name="pickup_time" type="timestamp"/>
            <column name="delivered_time" type="timestamp"/>
            <column name="failure_reason" type="varchar(1000)"/>
            <column name="proof_photos" type="text"/>

            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ========================================================= -->
    <!-- 2️⃣ TẠO CÁC BẢNG AXON EVENT STORE (Event Sourcing / Saga)  -->
    <!-- ========================================================= -->
    <changeSet id="002-init-axon-tables" author="microshop">

        <!-- DOMAIN_EVENT_ENTRY -->
        <createTable tableName="domain_event_entry">
            <column name="global_index" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_identifier" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="meta_data" type="BYTEA"/>
            <column name="payload" type="BYTEA"/>
            <column name="payload_revision" type="VARCHAR(255)"/>
            <column name="payload_type" type="VARCHAR(255)"/>
            <column name="time_stamp" type="VARCHAR(255)"/>
            <column name="aggregate_identifier" type="VARCHAR(255)"/>
            <column name="sequence_number" type="BIGINT"/>
            <column name="type" type="VARCHAR(255)"/>
        </createTable>

        <!-- SNAPSHOT_EVENT_ENTRY -->
        <createTable tableName="snapshot_event_entry">
            <column name="aggregate_identifier" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sequence_number" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="event_identifier" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meta_data" type="BYTEA"/>
            <column name="payload" type="BYTEA"/>
            <column name="payload_revision" type="VARCHAR(255)"/>
            <column name="payload_type" type="VARCHAR(255)"/>
            <column name="time_stamp" type="VARCHAR(255)"/>
        </createTable>

        <!-- ASSOCIATION_VALUE_ENTRY -->
        <createTable tableName="association_value_entry">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="association_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="association_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="saga_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="saga_type" type="VARCHAR(255)"/>
        </createTable>

        <createIndex tableName="association_value_entry" indexName="idx_assoc_value_entry_key_val">
            <column name="association_key"/>
            <column name="association_value"/>
            <column name="saga_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
